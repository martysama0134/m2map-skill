# <CORPUS>, ...). The real values live here and are never committed.
# tools/scrub_paths.py --check enforces it.
/CLAUDE.local.md
/m2map.paths.json

# --- python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# --- mined artifacts that are large and regenerable ---
# JSON catalogs ARE committed (text, diffable, the actual distilled knowledge).
# These are the heavy regenerable byproducts of `mine_corpus.py`.
/skills/m2map/reference/catalog/patches/
/skills/m2map/reference/catalog/sheets/
/skills/m2map/reference/catalog/*.npy
/skills/m2map/reference/catalog/.cache/

